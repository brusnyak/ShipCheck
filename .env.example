# GEMINI_API_KEY: Required only if Gemini AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string (e.g. Neon free tier or local Docker Postgres).
# When unset in local preview, ShipCheck uses its local persistent store + Firestore.
DATABASE_URL="postgresql://shipcheck:shipcheck_dev_password@localhost:5432/shipcheck?schema=public"

# Scanner configuration
MAX_CONCURRENT_SCANS="1"
MAX_PAGES_PER_SCAN="4"
# Optional remote Chromium WebSocket endpoint (e.g. Browserless) for screenshots on serverless hosts
BROWSER_WS_ENDPOINT=""

# Security & testing overrides
# Set ALLOW_LOCAL_SCANS="true" ONLY for local Playwright E2E testing against localhost.
ALLOW_LOCAL_SCANS="false"
ENABLE_DEMO_FIXTURE="true"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
