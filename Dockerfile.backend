# Multi-stage Dockerfile for ShipCheck Backend + Playwright Chromium
FROM mcr.microsoft.com/playwright:v1.52.0-noble AS deps
WORKDIR /app

COPY package.json package-lock.json* bun.lock* ./
COPY backend/prisma ./backend/prisma

RUN npm ci --ignore-scripts || npm install --ignore-scripts
RUN npx prisma generate --schema=backend/prisma/schema.prisma

FROM mcr.microsoft.com/playwright:v1.52.0-noble AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV MAX_CONCURRENT_SCANS=1
ENV MAX_PAGES_PER_SCAN=4
ENV NODE_OPTIONS="--max-old-space-size=384"

COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json firebase-applet-config.json ./
COPY server.ts ./
COPY backend ./backend
COPY index.html vite.config.ts ./
COPY src ./src

RUN npm run build && npm prune --omit=dev

EXPOSE 3000

CMD ["sh", "-c", "npx prisma db push --schema=backend/prisma/schema.prisma --skip-generate && npm start"]
